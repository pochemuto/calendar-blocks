{
	"name": "calendar-blocks",
	"version": "0.1.4",
	"description": "An Obsidian plugin for rendering date and date-range code blocks as calendars.",
	"main": "build/main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
		"test": "npm run test:unit && npm run test:visual",
		"test:unit": "vitest run",
		"test:visual": "node tests/visual/run.mjs",
		"test:visual:update": "node tests/visual/run.mjs --update-snapshots",
		"test:visual:report": "playwright show-report"
	},
	"keywords": [
		"obsidian",
		"calendar",
		"date"
	],
	"author": "pochemuto",
	"license": "MIT",
	"devDependencies": {
		"@fontsource-variable/noto-sans": "5.3.0",
		"@playwright/test": "1.64.1",
		"@types/node": "^22.15.17",
		"@types/pngjs": "6.0.5",
		"esbuild": "0.25.5",
		"jsdom": "^29.1.1",
		"obsidian": "^1.12.2",
		"pngjs": "7.0.0",
		"typescript": "^5.8.3",
		"vitest": "^4.1.9",
		"yaml": "2.9.1"
	}
}
